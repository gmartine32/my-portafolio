---
import "../styles/global.css";
import Navigation from "../components/Navigation.tsx";
import HeroSection from "../components/sections/HeroSection.astro";
import AboutSection from "../components/sections/AboutSection.astro";
import ProjectsSection from "../components/sections/ProjectsSection.astro";
import ExperienceSection from "../components/sections/ExperienceSection.astro";
import ContactSection from "../components/sections/ContactSection.tsx";
import { Toaster } from "../components/ui/toaster.tsx";
import { CustomCursor } from "../components/ui/CustomCursor.tsx";

const siteBase = Astro.site || Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, siteBase);
// Imagen por defecto (reemplazable cuando tengas una foto u otro preview):
const ogImage = new URL('/img/kiex.webp', siteBase);
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />
		<title>Gian Martínez - Frontend Developer & Ingeniero de Software</title>
		<meta name="description" content="Portafolio de Gian Martínez. Desarrollador Full Stack, Frontend Developer e Ingeniero de Software experto en React, Astro, Next.js y ecosistema Node.js." />
		<meta name="keywords" content="Gian Martinez, Gian Martinez Frontend, Gian Martinez Software, Gian Martinez Developer, Ingeniero de Software, Full Stack Developer, React Developer" />
		<meta name="author" content="Gian Martínez" />
		<meta property="og:title" content="Portafolio de Gian Martínez | Full Stack Developer" />
		<meta property="og:description" content="Portafolio profesional de Gian Martínez, desarrollador full stack especializado en React, Astro, Tailwind CSS y tecnologías modernas." />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Portafolio de Gian Martínez | Full Stack Developer" />
		<meta name="twitter:description" content="Portafolio profesional de Gian Martínez, desarrollador full stack especializado en React, Astro, Tailwind CSS y tecnologías modernas." />
		<meta name="twitter:image" content={ogImage} />
		
		<!-- JSON-LD Schema.org Data para dominar en Búsquedas -->
		<script type="application/ld+json">
			{
			  "@context": "https://schema.org/",
			  "@type": "Person",
			  "name": "Gian Martínez",
			  "jobTitle": "Frontend Developer & Software Engineer",
			  "url": "https://gianmartinez.dev",
			  "sameAs": [
				"https://www.linkedin.com/in/gianmartinezvilla",
				"https://github.com/gmartine32"
			  ],
			  "knowsAbout": ["Frontend Development", "Software Engineering", "React", "Next.js", "Astro", "Full Stack"]
			}
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<CustomCursor client:load />
		<div class="noise-bg"></div>
		<Toaster client:load/>
		<div class="min-h-screen bg-background">
			<nav>
				<Navigation client:load/>
			</nav>
			<main>
				<HeroSection />
				<AboutSection />
				<ProjectsSection />
				<ExperienceSection />
				<ContactSection client:load/>
			</main>
		</div>
	</body>
</html>
