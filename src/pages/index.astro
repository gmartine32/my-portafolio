---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import World from "../components/world/World.tsx";
import { profile, projects, experiences } from "../data/content";

const siteBase = Astro.site || Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const pageTitle = "Espacio de Gian Martínez";
const pageDescription =
	"Senior Full Stack & AI-Augmented Engineer. Portafolio interactivo con proyectos, experiencia y contacto.";
const ogImage = new URL("/img/og/espacio-gian-martinez.jpg", siteBase);
const ogImageAlt = "Espacio de Gian Martínez — Senior Full Stack & AI-Augmented Engineer";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta
			name="keywords"
			content="Gian Martinez, Gian Martinez Frontend, Gian Martinez AI, AI-Augmented Developer, Senior Full Stack Engineer, Ingeniero de Software, React, Next.js, React Native, Spring Boot, Go, Cursor, Claude Code, RAG"
		/>
		<meta name="author" content="Gian Martínez" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={pageTitle} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org/",
			"@type": "Person",
			"name": "Gian Martínez",
			"jobTitle": "Senior Full Stack & AI-Augmented Engineer",
			"url": "https://gianmartinez.space",
			"sameAs": [
				"https://www.linkedin.com/in/gianmartinezvilla",
				"https://github.com/gmartine32"
			],
			"knowsAbout": [
				"Frontend Development",
				"Software Engineering",
				"AI-Augmented Development",
				"RAG Pipelines",
				"Spec-Driven Development",
				"React",
				"Next.js",
				"React Native",
				"Spring Boot",
				"Go",
				"Full Stack"
			],
			"hasCredential": {
				"@type": "EducationalOccupationalCredential",
				"name": "Ingeniería de Sistemas",
				"credentialCategory": "degree",
				"recognizedBy": {
					"@type": "Organization",
					"name": "Universidad de la Costa"
				},
				"url": "https://app.certika.co/badges/MjA2NTU="
			}
		})} />

		<script is:inline>
			(function () {
				var KEY = "portfolio:locale:v1";
				var supported = ["es", "en"];
				try {
					var saved = localStorage.getItem(KEY);
					if (saved && supported.indexOf(saved) !== -1) {
						document.documentElement.lang = saved;
						return;
					}
				} catch (e) {}
				var langs = navigator.languages || [navigator.language];
				for (var i = 0; i < langs.length; i++) {
					var tag = String(langs[i] || "")
						.toLowerCase()
						.replace("_", "-");
					var base = tag.split("-")[0];
					if (supported.indexOf(base) !== -1) {
						document.documentElement.lang = base;
						return;
					}
				}
				document.documentElement.lang = "es";
			})();
		</script>
	</head>
		<body class="bg-background text-foreground antialiased">
		<main>
			{/* client:only — World is browser-only (pointer, history, motion); skip SSR */}
			<World client:only="react" />
		</main>

		<section class="sr-only" aria-label="Contenido del portfolio para lectores y buscadores">
			<h1>{profile.name} — {profile.title}</h1>
			<p>{profile.bio}</p>
			<h2>Proyectos</h2>
			<ul>
				{projects.map((project) => (
					<li>
						<strong>{project.title}</strong>: {project.description}
					</li>
				))}
			</ul>
			<h2>Experiencia</h2>
			<ul>
				{experiences.map((exp) => (
					<li>
						<strong>{exp.position}</strong> en {exp.company} ({exp.period}). {exp.description}
					</li>
				))}
			</ul>
			<h2>Contacto</h2>
			<p>
				<a href={profile.email}>{profile.emailLabel}</a>
				{" · "}
				<a href={profile.linkedin}>LinkedIn</a>
				{" · "}
				<a href={profile.github}>GitHub</a>
				{" · "}
				<a href={profile.cvUrl}>CV</a>
			</p>
		</section>

		<noscript>
			<div class="mx-auto max-w-3xl space-y-8 px-6 py-16">
				<h1 class="font-heading text-4xl font-bold">{profile.name}</h1>
				<p class="text-lg text-muted-foreground">{profile.subtitle}</p>
				<p>{profile.bio}</p>
				<p>
					Activa JavaScript para explorar el portfolio como un mundo de habitaciones conectadas,
					o usa los enlaces de contacto.
				</p>
				<ul class="space-y-2">
					<li><a href={profile.github}>GitHub</a></li>
					<li><a href={profile.linkedin}>LinkedIn</a></li>
					<li><a href={profile.email}>Email</a></li>
					<li><a href={profile.cvUrl}>Descargar CV</a></li>
				</ul>
			</div>
		</noscript>
		<Analytics />
	</body>
</html>
